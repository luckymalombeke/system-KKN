# Salin ke .env lalu isi nilai nyata (jangan commit .env)

PORT=8081

# Wajib: minimal 32 karakter, acak. Contoh generate (PowerShell):
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kkn_db
DB_PORT=5432
DB_SSLMODE=disable

OTP_DEV_LOG=true
OTP_EXPIRY_MINUTES=5

# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_SKIP_SIGNATURE_VERIFY=false
# PAYMENT_EXPIRY_HOURS=24
